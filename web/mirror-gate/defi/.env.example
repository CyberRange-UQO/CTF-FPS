# Default binding is local. Set 0.0.0.0 only for the intended lab ingress.
MIRROR_BIND=127.0.0.1
MIRROR_PORT=8082
# Private, unused /24; this prefix updates both IPAM and transport pinning.
MIRROR_LAB_PREFIX=172.30.82
# Generate a unique random secret per instance (see README). Never commit .env.
SESSION_SECRET=
# true behind the lab HTTPS ingress; false only for local HTTP.
SESSION_COOKIE_SECURE=false
